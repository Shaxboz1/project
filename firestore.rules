rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // KEBABO raqamli menyu ma'lumotlari:
    // Istalgan kishi (mehmonlar) menyuni O'QISHI mumkin (read: true).
    // Faqat autentifikatsiyadan o'tgan administrator O'ZGARTIRISHI mumkin (write: if request.auth != null).
    match /menu_data/{documentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Har qanday boshqa hujjatlar uchun begona kirish taqiqlanadi
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
